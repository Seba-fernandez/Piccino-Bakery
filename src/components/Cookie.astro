---
// Cookie responsive: AVIF con WebP de respaldo, en dos anchos (480 y el original). Generado por scratchpad/tools/variants.py.
import img from '../data/img.json';

interface Props {
  name: string;
  sizes: string;
  alt?: string;
  class?: string;
  lazy?: boolean;
  priority?: boolean;
  [attr: string]: unknown;
}
const { name, sizes, alt = '', class: cls, lazy = true, priority = false, ...rest } = Astro.props;
const m = (img as Record<string, { w: number[]; h: number; full: number }>)[name];
const base = import.meta.env.BASE_URL;
const set = (ext: string) => m.w.map((w) => `${base}img/${name}-${w}.${ext} ${w}w`).join(', ');
---
<picture>
  <source type="image/avif" srcset={set('avif')} sizes={sizes} />
  <img
    class={cls}
    src={`${base}img/${name}-${m.full}.webp`}
    srcset={set('webp')}
    sizes={sizes}
    alt={alt}
    width={m.full}
    height={m.h}
    loading={lazy && !priority ? 'lazy' : undefined}
    fetchpriority={priority ? 'high' : undefined}
    decoding="async"
    {...rest}
  />
</picture>
